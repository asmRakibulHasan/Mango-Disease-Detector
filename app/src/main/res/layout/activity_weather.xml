<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_r16"
                    android:clickable="true"
                    android:contentDescription="@string/btn_back"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    style="@style/Text.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/weather_title"
                    android:textSize="22sp" />

                <FrameLayout
                    android:id="@+id/btnSpeak"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle3d_green"
                    android:clickable="true"
                    android:contentDescription="@string/weather_listen"
                    android:focusable="true"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_speaker" />
                </FrameLayout>
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/red" />

                <TextView
                    android:id="@+id/tvLocation"
                    style="@style/Text.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnChangeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_pill_outline_green"
                    android:fontFamily="@font/hind_bold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/weather_change_location"
                    android:textColor="@color/green_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Loading -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminateTint="@color/sky" />

                <TextView
                    android:id="@+id/tvLoading"
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/weather_loading"
                    android:textColor="@color/sky"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Error -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_r24"
                android:backgroundTint="@color/info_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_r16"
                    android:backgroundTint="@color/sky">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud_line" />
                </FrameLayout>

                <TextView
                    style="@style/Text.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/weather_error"
                    android:textColor="@color/info_title"
                    android:textSize="19sp" />

                <LinearLayout
                    android:id="@+id/btnRetry"
                    style="@style/Button3D.Green"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="18dp">

                    <TextView
                        style="@style/Text.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_try_again"
                        android:textColor="@color/white"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Content -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_r16"
                    android:backgroundTint="@color/caution_bg"
                    android:fontFamily="@font/hind_semibold"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/weather_offline"
                    android:textColor="@color/caution_title"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Current weather card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/sky"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-44dp"
                            android:layout_marginEnd="-36dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/sun" />

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="22dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/wx_cloud"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingTop="22dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="18dp">

                            <TextView
                                android:id="@+id/tvTemperature"
                                style="@style/Text.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="76sp" />

                            <TextView
                                android:id="@+id/tvCondition"
                                style="@style/Text.Heading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-10dp"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tvDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/sky_text"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_r16"
                                    android:backgroundTint="#29FFFFFF"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_drop_line" />

                                    <TextView
                                        android:id="@+id/tvHumidity"
                                        style="@style/Text.Heading"
                                        android:layout_width="match_parent"
                                        android:layout_height="28dp"
                                        android:layout_marginTop="2dp"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        app:autoSizeMaxTextSize="18sp"
                                        app:autoSizeMinTextSize="11sp"
                                        app:autoSizeTextType="uniform" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/weather_humidity"
                                        android:textColor="@color/sky_light"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_r16"
                                    android:backgroundTint="#29FFFFFF"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_rain_line" />

                                    <TextView
                                        android:id="@+id/tvRainChance"
                                        style="@style/Text.Heading"
                                        android:layout_width="match_parent"
                                        android:layout_height="28dp"
                                        android:layout_marginTop="2dp"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        app:autoSizeMaxTextSize="18sp"
                                        app:autoSizeMinTextSize="11sp"
                                        app:autoSizeTextType="uniform" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/weather_rain_chance"
                                        android:textColor="@color/sky_light"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_r16"
                                    android:backgroundTint="#29FFFFFF"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_wind_line" />

                                    <TextView
                                        android:id="@+id/tvWind"
                                        style="@style/Text.Heading"
                                        android:layout_width="match_parent"
                                        android:layout_height="28dp"
                                        android:layout_marginTop="2dp"
                                        android:gravity="center"
                                        android:maxLines="1"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        app:autoSizeMaxTextSize="18sp"
                                        app:autoSizeMinTextSize="11sp"
                                        app:autoSizeTextType="uniform" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/weather_wind"
                                        android:textColor="@color/sky_light"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Advice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_leaf_line"
                        app:tint="@color/green_primary" />

                    <TextView
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/weather_advice_title"
                        android:textColor="@color/green_primary"
                        android:textSize="22sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 7-day forecast -->
                <TextView
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/weather_forecast_title"
                    android:textColor="@color/sky"
                    android:textSize="22sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="-18dp"
                    android:clipToPadding="false"
                    android:paddingEnd="18dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutForecast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/weather_source"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

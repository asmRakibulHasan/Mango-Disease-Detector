<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Illustration: mango-yellow disc, phone frame, round badge -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="290dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/mango_skin" />

        <View
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/mint_strong" />

        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/apricot" />

        <!-- Phone -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="230dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_r28"
            android:backgroundTint="@color/text_primary"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_r20"
                android:backgroundTint="@color/mint">

                <ImageView
                    android:id="@+id/ivOnboarding"
                    android:layout_width="96dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_leaf_veins" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="18dp"
                    android:background="@drawable/bg_dashed_frame" />
            </FrameLayout>
        </FrameLayout>

        <!-- Badge -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/green_primary"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_camera_line"
                app:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:textColor="@color/green_primary"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="300dp"
        android:textColor="@color/ink_soft"
        android:textSize="20sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp"><shape android:shape="oval">
                <solid android:color="@color/green_deep" />
            </shape></item>
            <item android:top="2dp" android:bottom="2dp"><shape android:shape="oval">
                <solid android:color="@color/green_primary" />
            </shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="0dp"><shape android:shape="oval">
                <solid android:color="@color/green_deep" />
            </shape></item>
            <item android:top="0dp" android:bottom="4dp"><shape android:shape="oval">
                <solid android:color="@color/green_primary" />
            </shape></item>
        </layer-list>
    </item>
</selector>
